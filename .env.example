# Groq API anahtarı (zorunlu)
GROQ_API_KEY=

# Üretim modeli (Policy / Critic / Vanilla)
MODEL_NAME=openai/gpt-oss-120b

# Kör yargıç modelleri (virgülle ayrılmış). Üretimle AYNI model aileden bağımsız en az bir yargıç ekleyin:
# JUDGE_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
JUDGE_MODELS=openai/gpt-oss-120b

# Güvenilirlik
REQUEST_TIMEOUT=45
MAX_RETRIES=2
MAX_REVISIONS=3

# Deney
# Uzman etiketli vakalar (yoksa dosya yok sayılır)
# CASES_EXPERT_JSON=cases_expert.json
# Eski 50 vakada risk_level=high olanları GEÇİCİ olarak pozitif say (uzman etiketi DEĞİLDİR; yalnızca deneme için)
# LEGACY_HIGH_AS_RED_FLAG=1
# BENCHMARK_OUT_DIR=benchmark_runs
