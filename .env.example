# Kopyalayın: cp .env.example .env   (.env Git'e ve Docker imajına girmez)
# Anahtarı kaynak koda, sohbete veya loga yazmayın; sızarsa Groq konsolundan iptal edin.
GROQ_API_KEY=

# --- Modeller (hepsi varsayılan olarak MODEL_NAME) ---
MODEL_NAME=openai/gpt-oss-120b
# CRITIC_MODEL=
# SEMANTIC_MODEL=
# MEMORY_MODEL=
# AFFECT_MODEL=

# Kör yargıç modelleri (virgülle ayrılmış). Varsayılan üretim modeliyle AYNI olduğundan bağımsızlık yoktur;
# farklı bir model ailesinden en az bir yargıç ekleyip doğrulayın, ör.:
# JUDGE_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile
JUDGE_MODELS=openai/gpt-oss-120b

# --- Güvenilirlik ---
REQUEST_TIMEOUT=45
MAX_RETRIES=2
MAX_REVISIONS=3

# --- Veri ve çıktılar ---
# Denetim kaydı, benchmark ve etiket dosyaları için kök dizin (varsayılan: ./runtime)
# RESEARCH_DATA_DIR=runtime
# Uzman etiketli vakalar (yoksa dosya yok sayılır; Git'e eklemeyin)
# CASES_EXPERT_JSON=runtime/cases_expert.json
# BENCHMARK_OUT_DIR=runtime/benchmark_runs
# Eski 50 vakada risk_level=high olanları GEÇİCİ pozitif say (uzman etiketi DEĞİLDİR; yalnızca altyapı denemesi)
# LEGACY_HIGH_AS_RED_FLAG=1

# --- Erişim kapısı ---
# Parola hash'i üretmek için: python app_auth.py
# Yerelde kapı varsayılan kapalıdır; Docker/compose APP_REQUIRE_AUTH=1 ile açar.
# APP_REQUIRE_AUTH=1
# APP_PASSWORD_HASH=
